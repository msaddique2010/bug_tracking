<p style="color: green"><%= notice %></p>

<%= render @project %>

<div>
  <%= link_to "Edit this project", edit_project_path(@project) %> |
  <%= link_to "Back to projects", projects_path %>

  <%= button_to "Destroy this project", @project, method: :delete %>
</div>

<div>
  <br><br>
  <%= link_to "Add a Bug", new_project_bug_path(@project)%>
  <br>---------- Bugs ---------- <br>
  <%@bugs.each do |bug|%>
  <div>
    <strong>Title:</strong>
    <%= bug.title %>
  </div>

  <div>
    <strong>Deadline:</strong>
    <%= bug.deadline %>
  </div>

  <div>
    <strong>Bug type:</strong>
    <%= bug.bug_type %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= bug.status %>
  </div>
  <%# <%= link_to "Show this bug", project_bug_path(@project, @bug) %>
  <br>
  ------------------------------------------<br><br>
  <%end%>
</div>
