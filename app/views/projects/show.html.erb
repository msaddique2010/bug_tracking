<div>
  <p><%= notice %></p>

  <div>
    <div>
      <h1><%= @project.name %></h1>
      <p>Created by: <strong><%= @project.user.name %></strong> (<%= @project.user.email %>)</p>
    </div>
    <div>
      <%= link_to "Back to Projects", projects_path %>
      
      <% if policy(@project).edit? %>
        <%= link_to "Edit Project / Manage Team", edit_project_path(@project) %>
      <% end %>

      <% if policy(@project).destroy? %>
        <%= button_to "Delete Project", @project, method: :delete, data: { confirm: "Are you sure?" } %>
      <% end %>
    </div>
  </div>

  <div>
    <h3>Description</h3>
    <p><%= @project.description.presence || "No description provided." %></p>
  </div>

  <div>
    <h3>Assigned Team Members</h3>
    <div>
      <% if @project.users.any? %>
        <% @project.users.each do |user| %>
          <div>
            <strong><%= user.name %></strong>
            <span><%= user.user_type %></span>
          </div>
        <% end %>
      <% else %>
        <p>No team members assigned yet.</p>
      <% end %>
    </div>
  </div>

  <!-- Bugs Section -->
  <div>
    <div>
      <h2>Bugs & Features</h2>
      <div>
        <%= link_to "View All Bugs & Filters", project_bugs_path(@project) %>
        <% if policy(Bug.new(project: @project)).create? %>
          <%= link_to "Report New Bug", new_project_bug_path(@project) %>
        <% end %>
      </div>
    </div>

    <!-- Mini Bug List -->
    <% if @bugs.any? %>
      <div>
        <% @bugs.take(5).each do |bug| %>
          <div>
            <div>
              <span><%= bug.bug_type %></span>
              <span><%= bug.status %></span>
              <h4><%= bug.title %></h4>
              <span>Deadline: <%= bug.deadline.presence || "No deadline" %> | Assignee: <%= bug.developer ? bug.developer.name : "Unassigned" %></span>
            </div>
            <div>
              <%= link_to "Details", project_bug_path(@project, bug) %>
            </div>
          </div>
        <% end %>
        <% if @bugs.size > 5 %>
          <div>
            <%= link_to "Show all #{@bugs.size} bugs...", project_bugs_path(@project) %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div>
        <p>No bugs or features reported for this project yet.</p>
      </div>
    <% end %>
  </div>
</div>
