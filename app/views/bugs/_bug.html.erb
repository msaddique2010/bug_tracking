<div id="<%= dom_id bug %>">
  <div>
    <strong>Title:</strong>
    <%= bug.title %>
  </div>

  <div>
    <strong>Deadline:</strong>
    <%= bug.deadline %>
  </div>

  <div>
    <strong>Bug type:</strong>
    <%= bug.bug_type %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= bug.status %>
  </div>

  <div>
    <strong>Image:</strong>
    <div style="height: 100px">
      <%= image_tag @bug.image, style: "height: 100px; width: auto;" %>
    </div>
  </div>

</div>
