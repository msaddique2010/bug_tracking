<div id="<%= dom_id bug %>">
  <div>
    <strong>Title:</strong>
    <%= bug.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= bug.description.presence || "No description provided." %>
  </div>

  <div>
    <strong>Deadline:</strong>
    <%= bug.deadline.presence || "No deadline set" %>
  </div>

  <div>
    <strong>Bug Type:</strong>
    <span><%= bug.bug_type %></span>
  </div>

  <div>
    <strong>Status:</strong>
    <span><%= bug.status %></span>
  </div>

  <% if bug.image.attached? %>
    <div>
      <strong>Screenshot:</strong>
      <div>
        <%= image_tag bug.image %>
      </div>
    </div>
  <% end %>
</div>
