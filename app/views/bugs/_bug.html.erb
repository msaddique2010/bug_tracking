<div id="<%= dom_id bug %>">
  <div>
    <strong>Title:</strong>
    <%= bug.title %>
  </div>

  <div>
    <strong>Deadline:</strong>
    <%= bug.deadline %>
  </div>

  <div>
    <strong>Bug type:</strong>
    <%= bug.bug_type %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= bug.status %>
  </div>

</div>
